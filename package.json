{
  "name": "lux-aqua-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LUX AQUA: waterwaarden noteren, teststrips inlezen, advies en opvolging. Webversie en Capacitor-app voor Android en iOS.",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "apk": "npm run sync && node scripts/apk.mjs",
    "apk:release": "npm run sync && node scripts/apk.mjs release",
    "assets": "npx @capacitor/assets generate --assetPath resources --android --ios --iconBackgroundColor \"#0B1530\" --iconBackgroundColorDark \"#0B1530\" --splashBackgroundColor \"#0D1730\" --splashBackgroundColorDark \"#0D1730\"",
    "winkelbeelden": "node scripts/maak-winkelbeelden.mjs",
    "screenshots": "node test/maak-screenshots.mjs",
    "test": "node test/smoke.mjs",
    "test:strip": "node test/strip-test.mjs",
    "test:native": "node test/native-test.mjs",
    "test:offline": "npm run build && node test/offline-test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.1"
  }
}
